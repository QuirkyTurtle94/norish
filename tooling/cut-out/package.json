{
  "name": "@norish/cut-out-tool",
  "version": "0.25.0-beta",
  "private": true,
  "type": "module",
  "description": "Makes the flat background of a picture see-through: artwork of any colours, or a mark of one colour.",
  "scripts": {
    "cut-out": "tsx src/cli.ts",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "typecheck": "pnpm exec tsc --noEmit",
    "test": "vitest run",
    "clean": "git clean -xdf .cache .turbo node_modules"
  },
  "dependencies": {
    "@norish/shared-server": "workspace:*",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@norish/eslint-config": "workspace:*",
    "@norish/prettier-config": "workspace:*",
    "@norish/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "4.23.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@norish/prettier-config"
}
