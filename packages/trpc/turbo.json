{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "env": ["DATABASE_URL", "MASTER_KEY", "AUTH_URL"]
    },
    "build": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/tooling/typescript/**"
      ]
    }
  }
}
